# docker/.env.secrets — secrets (NEVER commit the real file; only .env.secrets.example is tracked)
# Copy this to .env.secrets and fill in real values.
#
# Generate a strong MCP_ACCESS_KEY with:
#   openssl rand -hex 32
#
# Generate a strong POSTGRES_PASSWORD with:
#   openssl rand -hex 32

MCP_ACCESS_KEY=replace-me-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-me
