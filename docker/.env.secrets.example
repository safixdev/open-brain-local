# docker/.env.secrets — secrets (NEVER commit the real file; only .env.secrets.example is tracked)
# Copy this to .env.secrets and fill in real values.
#
# Generate a strong POSTGRES_PASSWORD with:
#   openssl rand -hex 32
#
# Note: the MCP endpoint has NO auth and is bound to 127.0.0.1 only — it is a
# private per-developer service. Access control for SHARED memory lives in
# Artifactory (RT repo permissions + the access token in jfrog-config), not here.

POSTGRES_PASSWORD=replace-me
