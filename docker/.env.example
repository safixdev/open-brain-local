# docker/.env — non-secret config (safe to commit the .example; never commit the real file)
# Copy this to .env and adjust as needed.

# Names the compose project (container/volume/network prefix: openbrain-*)
COMPOSE_PROJECT_NAME=openbrain

# Data-access driver: "postgres" for docker-compose, "supabase" for upstream Supabase deploy
DB_DRIVER=postgres

# PostgreSQL connection (matches the db service in docker-compose.yml)
DB_HOST=db
DB_PORT=5432
DB_NAME=openbrain
DB_USER=postgres

# Also consumed by the Postgres docker image (must match DB_NAME)
POSTGRES_DB=openbrain

# Deno server listen port (host side; container always listens on 8000).
# 8000 commonly collides with other dev servers (uvicorn, etc.); 8787 is safer.
PORT=8787

# ── Server image (distribution) ──────────────────────────────────────────────
# Leave UNSET to build from source (`docker compose build server`).
# To run a prebuilt image from your registry, set the full ref, then:
#   docker compose pull server && docker compose up -d --no-build
# OPENBRAIN_IMAGE=acme.jfrog.io/openbrain-docker/openbrain-mcp-server:v1.0.0

# Embedding endpoint — HuggingFace TEI (compose service name), OpenAI /v1 route.
LLM_BASE=http://tei:8080/v1
LLM_API_KEY=tei

# Embedding model served by TEI. This is the ONLY model the stack runs (metadata
# comes from the calling agent — no chat model). Must produce 1024-dim vectors to
# match the pgvector schema; mxbai-embed-large-v1 does. Changing to a different
# dimension requires editing init/01-init.sql and re-embedding.
EMBED_MODEL=mixedbread-ai/mxbai-embed-large-v1

# TEI image. Default targets x86_64. On Apple Silicon / arm64 hosts use the
# arm64 image (only a rolling `cpu-arm64-latest` tag is published):
#   TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# ── Artifactory (source of truth) ────────────────────────────────────────────
# The server shells out to the `jf` CLI using the config mounted at
# docker/jfrog-config/ (generate it with `jf config add` — see the open-brain-up
# skill). RT_REPO is the generic local repo your team created for memories.
JF_SERVER_ID=intro
RT_REPO=open-brain-memories

# ── Provenance ───────────────────────────────────────────────────────────────
# Fallback git username recorded on a memory when capture_thought does not supply
# `git_user`. Set to the deploying user/team identity.
GIT_USER=changeme
