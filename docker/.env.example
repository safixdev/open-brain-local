# docker/.env — non-secret config (safe to commit the .example; never commit the real file)
# Copy this to .env and adjust as needed.

# Names the compose project (container/volume/network prefix: openbrain-*)
COMPOSE_PROJECT_NAME=openbrain

# Data-access driver: "postgres" for docker-compose, "supabase" for upstream Supabase deploy
DB_DRIVER=postgres

# PostgreSQL connection (matches the db service in docker-compose.yml)
DB_HOST=db
DB_PORT=5432
DB_NAME=openbrain
DB_USER=postgres

# Also consumed by the Postgres docker image (must match DB_NAME)
POSTGRES_DB=openbrain

# Deno server listen port (host side; container always listens on 8000).
# 8000 commonly collides with other dev servers (uvicorn, etc.); 8787 is safer.
PORT=8787

# Ollama endpoint — use the compose service name, not host.docker.internal
LLM_BASE=http://ollama:11434/v1
LLM_API_KEY=ollama

# Ollama models (must match what ollama-pull downloads)
EMBED_MODEL=mxbai-embed-large
CHAT_MODEL=gemma3:4b

# Base URL used to build citation links in search/fetch results
OPEN_BRAIN_CITATION_BASE_URL=https://openbrain.local/thoughts
